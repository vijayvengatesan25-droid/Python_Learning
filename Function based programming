#positional and keyword arguments
"""
Student Info Function
Write a function student_info(name, age) and call it once using positional arguments, and once using keyword arguments.
"""

def student_info(name, age):
    print(f"The name is {name} and you are {age} years old")

student_info('vijay',30)  #Positional

student_info(age=32,name='tinesh')  #keyword and reverse


